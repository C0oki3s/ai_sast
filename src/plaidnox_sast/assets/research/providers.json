  "default_provider": "perplexity_sonar",
  "providers": {
    "perplexity_sonar": {
      "api_key_environment": "IFRIT_PERPLEXITY_API_KEY",
      "api_base_environment": "IFRIT_PERPLEXITY_API_BASE",
      "default_api_base": "https://api.perplexity.ai",
      "model_environment": "IFRIT_RESEARCH_SONAR_MODEL",
      "default_model": "sonar",
      "request_timeout_seconds": 180,
      "request_max_retries": 1,
      "provenance": "perplexity-sonar-direct"
    }
  }
}
