{
  "default_max_file_bytes": 1000000,
  "source_extensions": [
    ".c", ".cc", ".cpp", ".cs", ".go", ".h", ".hpp", ".java", ".js", ".jsx",
    ".json", ".kt", ".kts", ".php", ".properties", ".py", ".rb", ".rs", ".scala",
    ".sh", ".sql", ".swift", ".tf", ".tfvars", ".toml", ".ts", ".tsx", ".vue",
    ".ejs", ".erb", ".html", ".xml", ".yaml", ".yml"
  ],
  "source_filenames": [
    "Dockerfile", "Containerfile", "Makefile", "Gemfile", "Rakefile", "Jenkinsfile"
  ],
  "ignored_directories": [
    ".git", ".next", ".venv", "build", "dist", "node_modules", "vendor", "__pycache__"
  ],
  "extension_languages": {
    ".c": "c", ".cc": "cpp", ".cpp": "cpp", ".cs": "c_sharp", ".go": "go",
    ".h": "c", ".hpp": "cpp", ".java": "java", ".js": "javascript", ".jsx": "javascript",
    ".json": "json", ".kt": "kotlin", ".kts": "kotlin", ".php": "php",
    ".py": "python", ".rb": "ruby", ".rs": "rust", ".scala": "scala", ".sh": "bash",
    ".sql": "sql", ".swift": "swift", ".tf": "hcl", ".tfvars": "hcl", ".toml": "toml",
    ".ts": "typescript", ".tsx": "tsx", ".vue": "vue", ".html": "html", ".xml": "xml",
    ".yaml": "yaml", ".yml": "yaml"
  },
  "filename_languages": {
    "Dockerfile": "dockerfile", "Containerfile": "dockerfile", "Makefile": "make",
    "Gemfile": "ruby", "Rakefile": "ruby", "Jenkinsfile": "groovy"
  },
  "symbol_node_types": [
    "function_definition", "function_declaration", "function_item", "method_definition",
    "method_declaration", "constructor_declaration", "class_definition", "class_declaration",
    "interface_declaration", "struct_item", "impl_item", "method", "singleton_method",
    "arrow_function", "generator_function_declaration"
  ],
  "call_node_types": [
    "call", "call_expression", "method_invocation", "invocation_expression"
  ],
  "import_node_types": [
    "import_statement", "import_declaration", "use_declaration", "using_directive",
    "require", "include"
  ],
  "fallback_symbol_patterns": [
    "(?:function\\s+([A-Za-z_$][\\w$]*)|(?:const|let|var)\\s+([A-Za-z_$][\\w$]*)\\s*=\\s*(?:async\\s*)?\\([^)]*\\)\\s*=>)",
    "(?:async\\s+)?def\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\(",
    "(?:public|private|protected|static|final|synchronized|async|virtual|override|inline|extern|func|fn)*\\s*[A-Za-z_][A-Za-z0-9_<>,.?\\[\\] :*&]*\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*\\("
  ]
}
