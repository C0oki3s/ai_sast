{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases", "thresholds"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
          "required": ["case_id", "report_path", "expected_findings"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "report_path": {"type": "string", "minLength": 1},
          "comparison_report_path": {"type": "string", "minLength": 1},
          "expected_findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["expectation_id", "path"],
              "properties": {
                "expectation_id": {"type": "string", "minLength": 1},
                "path": {"type": "string", "minLength": 1},
                "vulnerability_class": {"type": "string"},
                "root_cause_contains": {"type": "string"},
                "invariant_contains": {"type": "string"},
                "capability_contains": {"type": "string"},
                "start_line": {"type": "integer", "minimum": 1},
                "end_line": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_recall", "minimum_precision", "maximum_duplicate_rate", "require_complete_scans"],
      "properties": {
        "minimum_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_duplicate_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "require_complete_scans": {"type": "boolean"},
        "maximum_discovery_calls": {"type": "integer", "minimum": 0},
        "maximum_calls_per_region": {"type": "number", "minimum": 0},
        "maximum_continuations": {"type": "integer", "minimum": 0},
        "maximum_raw_candidates": {"type": "integer", "minimum": 0},
        "maximum_candidate_duplicate_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_discovery_failures": {"type": "integer", "minimum": 0},
        "maximum_rate_limit_waits": {"type": "integer", "minimum": 0}
      }
    }
  }
}
