{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "supported": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "vulnerability_class": {
      "type": "string",
      "maxLength": 100
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 900,
      "description": "Reader-facing description: 2-4 plain sentences on what is wrong, where (name the function, route or file in backticks) and why the code allows it. No headings, no bullet lists, no line-break tokens."
    },
    "business_impact": {
      "type": "string",
      "maxLength": 700,
      "description": "Reader-facing impact: 1-3 sentences on what an attacker concretely gains, which users or data are affected, and any precondition such as required privileges."
    },
    "reasoning": {
      "type": "string",
      "maxLength": 600
    },
    "attack_path": {
      "type": "string",
      "maxLength": 600
    },
    "remediation_note": {
      "type": "string",
      "maxLength": 900,
      "description": "Reader-facing remediation: 1-3 sentences naming the exact function or check to change and the safe pattern to use. A short inline code example in backticks is allowed; no full patches."
    },
    "falsification_attempts": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      },
      "maxItems": 4
    },
    "required_preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      },
      "maxItems": 4
    },
    "evidence_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 300
      },
      "maxItems": 4
    },
    "security_invariant": {
      "type": "string",
      "maxLength": 600
    },
    "rejection_reason": {
      "type": "string",
      "maxLength": 600
    },
    "gate_results": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gate": {
            "type": "string",
            "enum": [
              "design_invariant",
              "reachability",
              "attacker_control",
              "effective_defense",
              "new_capability",
              "falsification",
              "reproduction",
              "remediation_invariant"
            ]
          },
          "verdict": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            },
            "maxItems": 3
          },
          "explanation": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "gate",
          "verdict",
          "evidence",
          "explanation"
        ]
      }
    },
    "evidence_locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 500
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "origin",
              "propagation",
              "boundary",
              "defense",
              "effect"
            ],
            "description": "origin: attacker-controlled input enters; propagation: the value is passed, transformed or stored; boundary: the check that should constrain it; defense: a control that is missing, removed or bypassed; effect: the sensitive operation reached."
          },
          "summary": {
            "type": "string",
            "maxLength": 240,
            "description": "One sentence for a reader: what happens to the attacker's value at this exact location, naming the variable or call in backticks."
          }
        },
        "required": [
          "path",
          "start_line",
          "end_line",
          "role",
          "summary"
        ]
      },
      "maxItems": 8,
      "description": "The taint path in attack order, from where attacker input enters (origin) to the sensitive effect: typically 3-6 locations. Include the changed root-cause lines, each propagation hop that moves the value across a function or file, and the effect. Each location is the smallest line range that shows that step."
    },
    "proof_plan": {
      "type": "array",
      "maxItems": 6,
      "description": "Reproduction steps in order, one action or observation per item, without numbering. Empty for an unsupported finding.",
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "proof_of_concept": {
      "type": "object",
      "additionalProperties": false,
      "description": "Runnable, non-destructive proof of concept for a supported finding. For an unsupported finding use language \"none\", no script lines and an empty expected result.",
      "properties": {
        "language": {
          "type": "string",
          "enum": [
            "bash",
            "http",
            "python",
            "javascript",
            "none"
          ],
          "description": "bash for a curl-based script (preferred), http for one raw HTTP request, python or javascript only when a shell request cannot show it."
        },
        "script_lines": {
          "type": "array",
          "maxItems": 60,
          "description": "The script, one source line per item, in order. Never put several lines in one item and never use \\n, </n> or <br> as separators. Use placeholders such as TARGET_URL and AUTH_TOKEN; never real credentials.",
          "items": {
            "type": "string",
            "maxLength": 400
          }
        },
        "expected_result": {
          "type": "string",
          "maxLength": 300,
          "description": "One sentence: what the output shows when the code is vulnerable, and what a fixed build returns instead."
        }
      },
      "required": [
        "language",
        "script_lines",
        "expected_result"
      ]
    },
    "regression_test": {
      "type": "string",
      "maxLength": 800
    },
    "classification_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "identifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "maxLength": 500
          },
          "source_url": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "namespace",
          "identifier",
          "name",
          "source_url"
        ]
      },
      "maxItems": 3
    },
    "context_requests": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "definition",
              "callers",
              "callees",
              "readers",
              "writers",
              "imports",
              "middleware",
              "route",
              "authorization_decision",
              "security_control",
              "store_relationship",
              "configuration",
              "environment_usage",
              "credential_consumer",
              "window",
              "sibling_handlers",
              "search",
              "knowledge",
              "flow"
            ]
          },
          "path": {
            "type": "string",
            "maxLength": 500
          },
          "symbol": {
            "type": "string",
            "maxLength": 300
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "pattern": {
            "type": "string",
            "maxLength": 300
          },
          "query": {
            "type": "string",
            "maxLength": 300
          }
        },
        "required": [
          "kind",
          "path",
          "symbol",
          "start_line",
          "end_line",
          "offset",
          "pattern",
          "query"
        ]
      }
    },
    "gained_capability": {
      "type": "string",
      "maxLength": 60
    }
  },
  "required": [
    "supported",
    "confidence",
    "title",
    "vulnerability_class",
    "classification_references",
    "severity",
    "message",
    "business_impact",
    "reasoning",
    "attack_path",
    "remediation_note",
    "falsification_attempts",
    "required_preconditions",
    "evidence_gaps",
    "security_invariant",
    "gained_capability",
    "rejection_reason",
    "gate_results",
    "evidence_locations",
    "proof_plan",
    "proof_of_concept",
    "regression_test",
    "context_requests"
  ]
}
