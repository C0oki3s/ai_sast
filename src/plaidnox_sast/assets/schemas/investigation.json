{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlaidNox Investigation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "investigation_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "schema_version": {"const": 1},
    "stable_key": {"type": "string", "minLength": 1, "maxLength": 512},
    "codebase_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "snapshot_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "target_ref": {"type": "object", "minProperties": 1},
    "reason": {"type": "string", "minLength": 1},
    "security_questions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "graph_refs": {"type": "array", "items": {"$ref": "#/$defs/graph_ref"}},
    "source_windows": {"type": "array", "items": {"$ref": "#/$defs/source_window"}},
    "context_dependencies": {"type": "array", "items": {"type": "object"}},
    "prior_evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["planned", "running", "candidate", "no_candidate", "unresolved", "failed", "skipped"]},
    "checkpoint_ref": {"type": ["string", "null"], "maxLength": 512},
    "revision": {"type": "integer", "minimum": 1}
  },
  "required": ["investigation_id", "schema_version", "stable_key", "codebase_id", "snapshot_id", "target_ref", "reason", "security_questions", "graph_refs", "source_windows", "context_dependencies", "prior_evidence_refs", "evidence_hash", "state", "checkpoint_ref", "revision"],
  "$defs": {
    "graph_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "edge_id": {"type": "string", "minLength": 1},
        "relation": {"type": "string", "minLength": 1},
        "provenance": {"enum": ["EXTRACTED", "INFERRED", "AMBIGUOUS"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "snapshot_id": {"type": "string", "minLength": 1}
      },
      "anyOf": [{"required": ["node_id"]}, {"required": ["edge_id", "relation"]}]
    },
    "source_window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "excerpt": {"type": "string"},
        "redaction_state": {"enum": ["redacted", "not_required"]}
      },
      "required": ["path", "start_line", "end_line", "content_hash", "excerpt", "redaction_state"]
    }
  }
}
