{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 240
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "category": {
            "type": "string",
            "maxLength": 80
          },
          "path": {
            "type": "string",
            "maxLength": 500
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "message": {
            "type": "string",
            "maxLength": 1200
          },
          "attack_path": {
            "type": "string",
            "maxLength": 1200
          },
          "evidence_basis": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "origin": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 800
                }
              },
              "propagation": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 800
                }
              },
              "expected_boundary": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 800
                }
              },
              "sensitive_effect": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 800
                }
              },
              "controls_checked": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 800
                }
              },
              "missing_evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 800
                }
              }
            },
            "required": [
              "origin",
              "propagation",
              "expected_boundary",
              "sensitive_effect",
              "controls_checked",
              "missing_evidence"
            ]
          },
          "vulnerability_class": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1
          },
          "classification_references": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "namespace": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "identifier": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "name": {
                  "type": "string",
                  "maxLength": 500
                },
                "source_url": {
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "required": [
                "namespace",
                "identifier",
                "name",
                "source_url"
              ]
            }
          },
          "business_impact": {
            "type": "string",
            "maxLength": 1600
          }
        },
        "required": [
          "title",
          "vulnerability_class",
          "classification_references",
          "business_impact",
          "severity",
          "confidence",
          "category",
          "path",
          "start_line",
          "end_line",
          "message",
          "attack_path",
          "evidence_basis"
        ]
      }
    },
    "coverage_complete": {
      "type": "boolean"
    },
    "next_focus": {
      "type": "string",
      "maxLength": 2000
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "obligations_reviewed": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 800
          }
        },
        "branches_reviewed": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 800
          }
        },
        "unresolved_areas": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 800
          }
        }
      },
      "required": [
        "obligations_reviewed",
        "branches_reviewed",
        "unresolved_areas"
      ]
    }
  },
  "required": [
    "candidates",
    "coverage_complete",
    "next_focus",
    "coverage"
  ]
}
